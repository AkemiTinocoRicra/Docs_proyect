{
    "$schema": "https://opencode.ai/config.json",
    "tools": {
        "mysql_*": true
    },
    "permission": {
        "mysql_*": "allow"
    },
    "mcp": {
        "servers": {
            "dart": {
                "type": "local",
                "command": [
                    "dart",
                    "mcp-server"
                ],
                 "cwd": ".",
                
                "enabled": true
            },
            "mysql": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@benborla29/mcp-server-mysql"
                ],
                "enabled": true,
                "timeout": 60000,
                "environment": {
                    "MYSQL_HOST": "127.0.0.1",
                    "MYSQL_PORT": "32772",
                    "MYSQL_USER": "root",
                    "MYSQL_PASS": "61203454",
                    "MYSQL_DB": "Booki",
                    "ALLOW_INSERT_OPERATION": "false",
                    "ALLOW_UPDATE_OPERATION": "false",
                    "ALLOW_DELETE_OPERATION": "false",
                    "ALLOW_DDL_OPERATION": "false"
                }
            }
        }
    }
}